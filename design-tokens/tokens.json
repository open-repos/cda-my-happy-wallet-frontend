{
  "meta": {
    "version": 1,
    "defaultTheme": "system",
    "themeStorageKey": "mhw-theme"
  },
  "primitive": {
    "color": {
      "neutral0": "#FFFFFF",
      "neutral100": "#F4F9F0",
      "neutral300": "#DCE2D8",
      "neutral500": "#A4B2BC",
      "neutral700": "#5E6875",
      "neutral900": "#343625",
      "neutral1000": "#1F2B1D",
      "green200": "#BFE0A5",
      "green700": "#43553A",
      "green800": "#075E3B",
      "greenSurface": "#D9F5E8",
      "coral500": "#EA7C69",
      "orange400": "#F09D65",
      "blue600": "#275DAD",
      "blueSurface": "#DCEBFF",
      "yellow800": "#6B5700",
      "yellowSurface": "#FFF4C2",
      "red700": "#A30707",
      "red800": "#842029",
      "redSurface": "#F8D7DA",
      "purple800": "#6B21A8",
      "lime700": "#4D7C0F",
      "rose600": "#E11D48",
      "amber700": "#B45309",
      "fuchsia600": "#C026D3",
      "pink800": "#9D174D",
      "cyan300": "#67E8F9",
      "indigo300": "#A5B4FC",
      "rose300": "#FDA4AF",
      "green300": "#86EFAC",
      "yellow300": "#FDE047",
      "fuchsia400": "#E879F9"
    },
    "fontFamily": {
      "heading": ["Barlow", "Arial", "sans-serif"],
      "body": ["Open Sans", "Arial", "sans-serif"],
      "mono": ["ui-monospace", "Menlo", "monospace"]
    },
    "fontSize": {
      "xs": 12,
      "sm": 14,
      "md": 16,
      "lg": 20,
      "xl": 24,
      "2xl": 32,
      "3xl": 48
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeight": {
      "tight": 1.2,
      "heading": 1.4,
      "body": 1.5
    },
    "space": {
      "0": 0,
      "1": 4,
      "2": 8,
      "3": 12,
      "4": 16,
      "5": 20,
      "6": 24,
      "8": 32,
      "10": 40,
      "12": 48,
      "16": 64
    },
    "size": {
      "controlSm": 40,
      "controlMd": 48,
      "contentSm": 440,
      "contentMd": 720
    },
    "borderWidth": { "thin": 1, "strong": 2 },
    "radius": { "sm": 6, "md": 10, "lg": 16, "pill": 999 },
    "shadow": {
      "sm": {
        "x": 0,
        "y": 2,
        "blur": 6,
        "spread": 0,
        "color": "rgba(31, 43, 29, 0.16)"
      },
      "md": {
        "x": 0,
        "y": 8,
        "blur": 24,
        "spread": 0,
        "color": "rgba(31, 43, 29, 0.2)"
      }
    },
    "duration": { "instant": 0, "fast": 120, "normal": 200 },
    "easing": { "standard": "cubic-bezier(0.2, 0, 0, 1)" },
    "zIndex": { "base": 0, "navigation": 100, "overlay": 1000, "toast": 5000 }
  },
  "shared": {
    "typography": {
      "headingFamily": "{primitive.fontFamily.heading}",
      "bodyFamily": "{primitive.fontFamily.body}",
      "bodySize": "{primitive.fontSize.md}",
      "bodyLineHeight": "{primitive.lineHeight.body}",
      "headingWeight": "{primitive.fontWeight.semibold}",
      "actionWeight": "{primitive.fontWeight.semibold}"
    },
    "space": {
      "controlInline": "{primitive.space.4}",
      "controlBlock": "{primitive.space.3}",
      "card": "{primitive.space.6}",
      "section": "{primitive.space.10}"
    },
    "size": { "controlMinHeight": "{primitive.size.controlMd}" },
    "borderWidth": {
      "default": "{primitive.borderWidth.thin}",
      "focus": "{primitive.borderWidth.strong}"
    },
    "radius": {
      "control": "{primitive.radius.sm}",
      "card": "{primitive.radius.md}"
    },
    "shadow": {
      "card": "{primitive.shadow.sm}",
      "overlay": "{primitive.shadow.md}"
    },
    "motion": {
      "durationFast": "{primitive.duration.fast}",
      "durationNormal": "{primitive.duration.normal}",
      "easingStandard": "{primitive.easing.standard}"
    },
    "zIndex": {
      "navigation": "{primitive.zIndex.navigation}",
      "overlay": "{primitive.zIndex.overlay}",
      "toast": "{primitive.zIndex.toast}"
    }
  },
