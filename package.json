    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "format": "prettier --check package.json .eslintrc.json vite.config.js vitest.config.js design-tokens scripts src/css/App.css src/css/Operations.css src/css/Profil.css src/css/design-tokens.css src/css/ThemeSelector.css src/js/components/OneOffOperations src/js/components/ThemeSelector.jsx src/js/design src/js/hooks/useOneOffOperations.js src/js/pages/ListeOperations.jsx src/js/pages/Profil.jsx src/js/services/oneOffOperationsService.js src/main.jsx test/e2e/responsive.spec.js test/vitest/designTokens.test.js test/vitest/oneOffOperationsPage.test.jsx test/vitest/oneOffOperationsService.test.js test/vitest/theme.test.jsx",
