VITE_ENV=development
VITE_API_BASE_URL=http://localhost:4200/v1/
# Public build configuration, read by production builds only. See docs/pwa-updates.md.
# true registers the service worker.
VITE_PWA_ENABLED=false
# Rollback only: true unregisters /sw.js and deletes the mhw-public-v1-* caches
# when VITE_PWA_ENABLED is not true.
VITE_PWA_RETIRE=false
